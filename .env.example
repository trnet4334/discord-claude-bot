# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_application_id_here
DISCORD_GUILD_ID=your_guild_id_here

# Access Control — single owner User ID
ALLOWED_USER_ID=your_discord_user_id_here

# Database
DATABASE_PATH=./data/bot.db

# Claude Code working directory (defaults to $HOME)
CLAUDE_WORK_DIR=/Users/yourname

# tmux session prefix
TMUX_PREFIX=discord-bot

# Logging
LOG_LEVEL=info

# Streaming tuning
STREAM_POLL_INTERVAL_MS=1500
STREAM_EDIT_DEBOUNCE_MS=500

# Timeout for dangerous command confirmation (ms)
DANGEROUS_CMD_TIMEOUT_MS=15000
